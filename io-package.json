{
  "common": {
    "name": "sharegy",
    "version": "2.2.0",
    "news": {
      "2.2.0": {
        "en": "Harden reconnection resilience with exponential backoff & liveness watchdog, add 24h autonomous offline schedule caching and dedicated floor heating tab",
        "de": "Robuste Wiederverbindung mit exponentiellem Backoff & Liveness-Watchdog, 24h-Offline-Fahrplan-Caching und eigener Fußbodenheizungs-Tab"
      },
      "2.1.0": {
        "en": "Add bidirectional floor heating thermal battery dispatch (DIN EN 12831), BWWP boost and WSS priority",
        "de": "Unterstützung für bidirektionale Fußbodenheizungs- & Estrichspeicher-Steuerung (DIN EN 12831), BWWP-Boost und WSS-Priorisierung"
      },
      "1.0.0": {
        "en": "Initial release of official Sharegy adapter with EMS, custom sensors and bidirectional load control",
        "de": "Erstveröffentlichung des offiziellen Sharegy Adapters mit EMS, Sensoren und Lastmanagement-Rückkanal"
      }
    },
    "title": "Sharegy Energy Management",
    "titleLang": {
      "en": "Sharegy Energy Management",
      "de": "Sharegy Energiemanagement"
    },
    "desc": {
      "en": "Connects ioBroker with the Sharegy Energy Management Platform (EMS, PV, Battery, Floor Heating, Heatpump, Wallbox & Dynamic Tariffs)",
      "de": "Verbindet ioBroker mit der Sharegy Energiemanagement-Plattform (EMS, PV, Speicher, Fußbodenheizung, Wärmepumpe, Wallbox & dynamische Tarife)"
    },
    "authors": [
      "Sharegy Team <info@sharegy.de>"
    ],
    "keywords": [
      "sharegy",
      "energy",
      "ems",
      "photovoltaic",
      "heatpump",
      "floorheating",
      "battery",
      "bwwp",
      "wallbox"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "main": "main.js",
    "icon": "sharegy.png",
    "enabled": true,
    "extIcon": "https://sharegy.de/favicon.ico",
    "type": "energy",
    "tier": 2,
    "mode": "daemon",
    "compact": true,
    "connectionType": "cloud",
    "dataSource": "poll",
    "adminUI": {
      "config": "json"
    },
    "installedFrom": "https://github.com/smartcuc/ioBroker.sharegy"
  },
  "native": {
    "protocol": "wss",
    "wsUrl": "wss://sharegy.de/ws/energy/",
    "host": "sharegy.de",
    "port": 8883,
    "path": "/mqtt",
    "mqttToken": "",
    "mqttUsername": "",
    "mqttPassword": "",
