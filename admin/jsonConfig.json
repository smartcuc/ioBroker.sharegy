{
  "i18n": true,
  "type": "tabs",
  "items": {
    "tabConnection": {
      "type": "panel",
      "label": "🔌 Verbindung",
      "items": {
        "headerConn": {
          "type": "header",
          "text": "Sichere Sharegy Plattform-Verbindung"
        },
        "infoConn": {
          "type": "staticText",
          "text": "Die Verbindung erfolgt standardmäßig sicher und verschlüsselt per WebSocket Secure (WSS über Port 443). Kopiere dazu einfach deine persönliche WebSocket-URL aus der Sharegy Web-App (unter Einstellungen -> Schnittstellen)."
        },
        "protocol": {
          "type": "select",
          "label": "Verbindungsprotokoll",
          "default": "wss",
          "options": [
            { "value": "wss", "label": "🔒 WSS (WebSocket Secure via Port 443 - Empfohlen & Firewall-sicher)" },
            { "value": "mqtts", "label": "🛡️ MQTTS (MQTT über TLS via Port 8883)" }
          ],
          "sm": 12,
          "md": 12
        },
        "dividerConnWss": {
          "type": "divider",
          "hidden": "data.protocol !== 'wss'"
        },
        "wsUrl": {
          "type": "text",
          "label": "WebSocket URL (Copy & Paste aus Sharegy Schnittstellen)",
          "default": "wss://sharegy.de/ws/energy/",
          "placeholder": "wss://sharegy.de/ws/energy/48f9d3b1-7a2e-4b9c-8512-32a10e7b89f0/",
          "help": "Kopiere die vollständige WebSocket-URL mit 1 Klick aus deinen Sharegy-Schnittstellen",
          "hidden": "data.protocol !== 'wss'",
          "sm": 12,
          "md": 12
        },
        "dividerConnMqtt": {
          "type": "divider",
          "hidden": "data.protocol !== 'mqtts'"
        },
        "host": {
          "type": "text",
          "label": "MQTT Server Host",
          "default": "sharegy.de",
          "hidden": "data.protocol !== 'mqtts'",
          "sm": 12,
          "md": 8
        },
        "port": {
          "type": "number",
          "label": "Port",
          "default": 8883,
          "min": 1,
          "max": 65535,
          "hidden": "data.protocol !== 'mqtts'",
          "sm": 12,
          "md": 4
        },
        "mqttToken": {
          "type": "text",
          "label": "Home Token (aus Sharegy Einstellungen)",
          "default": "",
          "help": "z. B. 48f9d3b1-7a2e-4b9c-8512-32a10e7b89f0",
          "hidden": "data.protocol !== 'mqtts'",
          "sm": 12,
          "md": 12
        },
        "mqttUsername": {
          "type": "text",
          "label": "Benutzername (optional)",
          "default": "",
          "hidden": "data.protocol !== 'mqtts'",
          "sm": 12,
          "md": 6
        },
        "mqttPassword": {
          "type": "password",
          "label": "Passwort (optional)",
          "default": "",
          "hidden": "data.protocol !== 'mqtts'",
          "sm": 12,
          "md": 6
        },
        "dividerGeneral": {
          "type": "divider"
        },
        "minSendIntervalSec": {
          "type": "number",
          "label": "Mindestsendeintervall (Sekunden)",
          "default": 5,
          "min": 1,
          "max": 300,
          "help": "Drosselung bei hochfrequenten ioBroker-Updates",
          "sm": 12,
          "md": 4
        },
        "bufferOfflineData": {
          "type": "checkbox",
          "label": "📦 Offline-Pufferung aktivieren (Messdaten bei Verbindungsabbruch zwischenspeichern)",
          "default": true,
          "help": "Verhindert Lücken in der Energiebilanz bei DSL-/Router-Neuverbindung oder Server-Wartung",
          "sm": 12,
          "md": 8
        },
        "maxBufferSize": {
          "type": "number",
          "label": "Max. gepufferte Datenpunkte (Ringpuffer)",
          "default": 5000,
          "min": 100,
          "max": 50000,
          "help": "Schützt den RAM von ioBroker bei tagelangem Internetausfall",
          "sm": 12,
          "md": 4
        }
      }
    },
    "tabEms": {
      "type": "panel",
      "label": "☀️ EMS & Kern-Zähler",
      "items": {
        "headerEms": {
          "type": "header",
          "text": "Energiemanagement-System (EMS) Hauptdatenpunkte"
        },
        "infoEms": {
          "type": "staticText",
          "text": "Wähle hier die zentralen Datenpunkte deiner PV-Anlage, des Netzanschlusses und deines Batteriespeichers aus. Diese speisen das Sharegy Live-Flussdiagramm und die Energiebilanz."
        },
        "pvPowerId": {
          "type": "objectId",
          "label": "PV-Erzeugung Leistung (W / kW)",
          "help": "z. B. sungrow.0.total_pv_power oder shelly.0.balkonkraftwerk.power",
          "sm": 12,
          "md": 8
        },
        "gridPowerId": {
          "type": "objectId",
          "label": "Netzleistung (W / kW)",
          "help": "z. B. smartmeter.0.1-0:16_7_0__255.value oder modbus.0.active_power",
          "sm": 12,
          "md": 8
        },
        "gridPowerSign": {
          "type": "select",
          "label": "Netz-Vorzeichenlogik",
          "default": "pos_import",
          "options": [
            {
              "value": "pos_import",
              "label": "+ positiv = Netzbezug / - negativ = Einspeisung"
            },
            {
              "value": "pos_export",
              "label": "+ positiv = Einspeisung / - negativ = Netzbezug"
            }
          ],
          "sm": 12,
          "md": 4
        },
        "gridImportId": {
          "type": "objectId",
          "label": "Netzbezug Zählerstand (kWh)",
          "help": "z. B. smartmeter.0.1-0:1_8_0__255.value",
          "sm": 12,
          "md": 6
        },
        "gridExportId": {
          "type": "objectId",
          "label": "Einspeisung Zählerstand (kWh)",
          "help": "z. B. smartmeter.0.1-0:2_8_0__255.value",
          "sm": 12,
          "md": 6
        },
        "dividerEmsBat": {
          "type": "divider"
        },
        "batteryPowerId": {
          "type": "objectId",
          "label": "Batteriespeicher Leistung (W / kW)",
          "help": "+ positiv = Laden / - negativ = Entladen",
          "sm": 12,
          "md": 6
        },
        "batterySocId": {
          "type": "objectId",
          "label": "Batterie Ladestand / SoC (%)",
          "help": "z. B. sungrow.0.battery_level oder victron.0.system.soc",
          "sm": 12,
          "md": 6
        },
        "houseConsumptionId": {
          "type": "objectId",
          "label": "Gesamter Hausverbrauch Leistung (W / kW, optional)",
          "help": "Falls leer, berechnet Sharegy den Hausverbrauch automatisch aus Erzeugung, Netz und Speicher.",
          "sm": 12,
          "md": 12
        }
      }
    },
    "tabCustomDevices": {
      "type": "panel",
      "label": "🌡️ Sonstige Geräte & Sensoren",
      "items": {
        "headerCustom": {
          "type": "header",
          "text": "Individuelle Geräte, Wärmepumpen, BWWP & Sensoren"
        },
        "infoCustom": {
          "type": "staticText",
          "text": "Füge hier beliebige ioBroker-Objekte hinzu (z. B. Brauchwasserwärmepumpe, Raumtemperatursensoren, Wallbox, Steckdosen), die als eigenständige Geräte in Sharegy erscheinen sollen. Die physikalische Einheit (°C, W, %, V etc.) wird automatisch anhand der Messgröße zugeordnet."
        },
        "customDevices": {
          "type": "table",
          "label": "Geräte- und Sensor-Mapping",
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Aktiv",
              "default": true,
              "width": "60px"
            },
            {
              "type": "objectId",
              "attr": "id",
              "title": "ioBroker Datenpunkt (Objekt-ID)",
              "width": "280px"
            },
            {
              "type": "text",
              "attr": "identifier",
              "title": "Sharegy Gerätekennung",
              "default": "device_1",
              "help": "z. B. bwwp_temp, bwwp_power, heatpump, wallbox",
              "width": "180px"
            },
            {
              "type": "select",
              "attr": "role",
              "title": "Funktion / Rolle",
              "default": "sensor",
              "options": [
                { "value": "sensor", "label": "🌡️ Sensor" },
                { "value": "consumer", "label": "🔌 Verbraucher" },
                { "value": "producer", "label": "☀️ Erzeuger" },
                { "value": "battery", "label": "🔋 Speicher" }
              ],
              "width": "140px"
            },
            {
              "type": "select",
              "attr": "metric",
              "title": "Messgröße (Einheit automatisch)",
              "default": "temperature",
              "options": [
                { "value": "temperature", "label": "Temperatur (°C)" },
                { "value": "power", "label": "Leistung (W)" },
                { "value": "soc", "label": "Ladestand (%)" },
                { "value": "voltage", "label": "Spannung (V)" },
                { "value": "current", "label": "Stromstärke (A)" },
                { "value": "energy", "label": "Energie / Zählerstand (kWh)" },
                { "value": "humidity", "label": "Luftfeuchtigkeit (%)" },
                { "value": "frequency", "label": "Frequenz (Hz)" }
              ],
              "width": "180px"
            },
            {
              "type": "number",
              "attr": "scale",
              "title": "Skalierung",
              "default": 1,
              "help": "z. B. 1000 bei kW -> W oder 0.001 bei Wh -> kWh",
              "width": "90px"
            }
          ]
        }
      }
    },
    "tabControl": {
      "type": "panel",
      "label": "🎛️ Rückkanal & Lastmanagement",
      "items": {
        "headerControl": {
          "type": "header",
          "text": "Bidirektionale Steuerung (Sharegy -> ioBroker)"
        },
        "infoControl": {
          "type": "staticText",
          "text": "Hier kannst du festlegen, welche Sharegy-Schaltbefehle und Lastmanagement-Sollwerte (z. B. BWWP SG-Ready Schaltung bei PV-Überschuss, Wallbox Ladestrom oder Speicher-Sollwert) in welche ioBroker-Objekte geschrieben werden."
        },
        "controlObjects": {
          "type": "table",
          "label": "Schaltkanal- und Sollwert-Mapping",
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Aktiv",
              "default": true,
              "width": "60px"
            },
            {
              "type": "text",
              "attr": "identifier",
              "title": "Sharegy Steuer-Kanal / Geräte-ID",
              "default": "bwwp_sg_ready",
              "help": "z. B. bwwp_sg_ready, wallbox_power, storage_target",
              "width": "180px"
            },
            {
              "type": "objectId",
              "attr": "targetId",
              "title": "Ziel-Objekt im ioBroker (zum Schalten)",
              "help": "z. B. shelly.0.shellyplus1#bwwp.Relay0.Switch",
              "width": "280px"
            },
            {
              "type": "select",
              "attr": "controlType",
              "title": "Steuer-Typ",
              "default": "switch_boolean",
              "options": [
                { "value": "switch_boolean", "label": "Ein / Aus Schalter (true / false)" },
                { "value": "power_limit_watt", "label": "Leistungsvorgabe (Watt)" },
                { "value": "current_limit_amper", "label": "Ladestrom (Ampere)" },
                { "value": "soc_target_pct", "label": "Ziel-SoC (%)" },
                { "value": "temperature_setpoint", "label": "Temperatur-Sollwert (°C)" }
              ],
              "width": "200px"
            },
            {
              "type": "checkbox",
              "attr": "invert",
              "title": "Invertieren (NC/NO)",
              "default": false,
              "width": "90px"
            }
          ]
        }
      }
    }
  }
}
